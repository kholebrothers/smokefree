# Sicherungen bleiben auf dem Gerät — auch in einem privaten Repo.
daten/
export/
*.export.json
laeufe*.json
rueckmeldungen*.json

# Der Artifact-Link ist ein Zugriffsschlüssel, keine Adresse.
LINK.local
*.local
